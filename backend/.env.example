# =================================================================
# ShopVerse Backend Environment Configuration
# =================================================================

# ── Flask Configuration ──────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
FLASK_DEBUG=true

# ── Aiven Cloud MySQL Connection (Primary Database) ──────────────
MYSQL_HOST=mysql-db-your-service.aivencloud.com
MYSQL_PORT=10875
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-aiven-mysql-password
MYSQL_SSL_MODE=REQUIRED

# Backward-compatible MySQL aliases
DB_HOST=mysql-db-your-service.aivencloud.com
DB_PORT=10875
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your-aiven-mysql-password
DB_SSL_MODE=REQUIRED

# ── Media Upload & Storage ───────────────────────────────────────
STORAGE_BACKEND=local
# Set to 's3' for AWS S3 deployment in DevOps phase
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
