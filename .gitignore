# =================================================================
# ShopVerse Root .gitignore
# =================================================================

# ── Environment & Secrets (CRITICAL: Never commit credentials) ────
.env
.env.*
*.env
backend/.env
frontend/.env
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials/
!*.example

# ── Python & Virtual Environments ────────────────────────────────
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
instance/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ── Node & Frontend Artifacts ────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# ── Uploaded User Media ──────────────────────────────────────────
backend/uploads/*
!backend/uploads/**/.gitkeep

# ── Database & Log Files ─────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.log
logs/

# ── Editor & IDE Directories ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ── OS Generated Files ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

